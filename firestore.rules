// firestore.rules
// -----------------------------------------------------------------------
// Deploy this in Firebase Console → Firestore Database → Rules, or via
// `firebase deploy --only firestore:rules` if you use the Firebase CLI.
//
// This is the ACTUAL access control for this site. Everything in
// js/auth.js (hiding the gear icon, the login modal) is just UX — a
// visitor with devtools open could call the Firestore SDK directly and
// try to bypass the page entirely. These rules are what stop them.
//
// Model used here: a hard-coded allowlist of admin UIDs, rather than
// Firebase custom claims. Custom claims need a privileged server (e.g. a
// Cloud Function using the Admin SDK) to set them, which this static site
// doesn't have. An allowlist is simpler and appropriate for "one or two
// admins" — swap to custom claims later if you outgrow it.
//
// SETUP:
// 1. Firebase Console → Authentication → Users → Add user. Create your
//    admin account (email + password).
// 2. Copy that user's UID from the Users table.
// 3. Paste it into the ADMIN_UIDS list below, replacing the placeholder.
// 4. Publish these rules.
//
// I have not verified this exact rules syntax against the current
// Firestore Rules docs as of your deploy date — check
// https://firebase.google.com/docs/firestore/security/get-started before
// publishing, since the rules language does evolve.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        // Replace with the real UID(s) from Firebase Console → Authentication → Users.
        'kiNNwWBjogYNoPp9SvCERQGG6033'
      ];
    }

    // OPTIONAL, STRICTER VERSION — checks that the current sign-in token was
    // actually produced by a second-factor sign-in, not just that the UID is
    // on the allowlist. This is real defense-in-depth: it protects you even
    // if a stale/pre-MFA session token were ever replayed.
    //
    // ⚠️ I have not verified `request.auth.token.firebase.sign_in_second_factor`
    // against Firestore's current Rules docs — check
    // https://firebase.google.com/docs/auth/web/multi-factor before switching
    // to this version, and test it in the Rules Playground first. If you
    // enable this and something about MFA breaks, you could lock yourself
    // out of writes from the app (you'd still have Firebase Console access
    // to fix rules directly — see js/auth.js "BREAK-GLASS" note).
    //
    // function isAdmin() {
    //   return request.auth != null
    //     && request.auth.uid in ['REPLACE_WITH_YOUR_ADMIN_UID']
    //     && request.auth.token.firebase.sign_in_second_factor != null;
    // }

    // Public course/config data: anyone can read (that's how the page
    // pulls its content on load), only allowlisted admins can write.
    match /site-config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
